# Frontend (Next.js). Copy to .env.local.
# Server-side only: where Next proxies /api/* to. Never prefix with NEXT_PUBLIC_.
BACKEND_URL=http://127.0.0.1:4000

# Display only (safe to expose to the browser).
NEXT_PUBLIC_APP_NAME=Birthday Desk
NEXT_PUBLIC_CHURCH_NAME=St. Thomas Church
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
