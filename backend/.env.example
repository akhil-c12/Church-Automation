# ---------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# The server refuses to start if a secret is missing or too weak.
# ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Exact origin of the dashboard (scheme://host[:port], no path).
# Next.js dev server runs on http://localhost:3000.
FRONTEND_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of this app (0 = none, 1 = one nginx/Caddy/LB).
TRUST_PROXY=0

ADMIN_USERNAME=admin
# bcrypt hash; generate with `npm run hash-password`. KEEP THE SINGLE QUOTES.
ADMIN_PASSWORD_HASH=''
# >= 32 random chars: openssl rand -hex 32. Changing it logs everyone out.
JWT_SECRET=
JWT_TTL_HOURS=12

N8N_WEBHOOK_BASE=
# use https://akrxc12.app.n8n.cloud/webhook-test while testing in the n8n editor
# Same value as the n8n credential "Church Backend API Key" (header X-API-Key).
N8N_API_KEY=
N8N_TIMEOUT_MS=30000

# n8n sends this in header X-Callback-Key when calling /hooks/n8n.
# >= 32 chars, must differ from N8N_API_KEY: openssl rand -hex 32
N8N_CALLBACK_KEY=
